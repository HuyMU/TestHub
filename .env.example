# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=testhub_db
DB_USER=testhub_user
DB_PASSWORD=testhub_pass
DB_ROOT_PASSWORD=rootpassword

# Application Backend Configuration
BACKEND_PORT=8080
# Generate a unique value with: openssl rand -hex 32
JWT_SECRET=changeme_generate_your_own_64_char_hex_secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
UPLOAD_DIR=./uploads
FRONTEND_ORIGIN=http://localhost:3000

# Default Seed Leader Account Credentials (used by LeaderSeeder.java on application startup)
SEED_LEADER_USERNAME=leader
SEED_LEADER_EMAIL=leader@testhub.com
SEED_LEADER_PASSWORD=Leader@123456
